# Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (optional for enhanced chatbot)
OPENAI_API_KEY=

# Application Settings
APP_NAME=Document Extractor Chatbot
APP_VERSION=1.0.0

# OCR Settings
OCR_DPI=300
OCR_LANGUAGE=eng

# Tesseract Path (Windows only - uncomment and set if needed)
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# Poppler bin path for Windows PDF conversion (optional if Poppler is not on PATH)
# POPPLER_PATH=C:\poppler-xx\Library\bin
